{
 "schemaVersion": "handout-intake.steps.v1",
 "status": "provisional",
 "why": [
  "顺序不能靠提示词约束,要靠数据依赖。",
  "第一次完整走通(物理 A10-A14)时,所有顺序错误都发生在既有两张子步骤表(Word 9 步、PDF 四步)之外",
  "那一段由人手工敲命令,于是:建蓝图时对象清单还不存在、修完 JPEG 又重建蓝图把修复冲掉、",
  "跳过第 0 步与第 2 步、源比对与引文门从头到尾没跑。",
  "落在 9 步子表里的部分一次都没错——因为它不给机会。",
  "一步跑不起来不该是因为「禁止跳」,该是因为它的输入还不存在。"
 ],
 "rules": {
  "ordering": "不声明顺序,顺序从 consumes/produces 的依赖图推出。表里 steps 的书写次序无语义。",
  "freshness": "每个产物记 sha256。步骤运行前校验每个 consumes 的当前 hash 与上次记录一致;不一致即 HOLD_INPUT_DRIFT,拒绝运行。",
  "precedent": "gate_semantic_blueprint_source_coverage 已经这么做了(manifest.blueprintSha256 对不上就拒绝)。本表把同一条纪律推广到全链。",
  "skipping": "跳步在结构上不可能:输入不存在就跑不了,不需要任何人守规矩。",
  "rerun": "上游 hash 变了,下游全部自动失效,不靠人记得重跑。",
  "noPathsHere": "**本表不含任何路径。** consumes/produces 一律写 artifacts 里的逻辑 id。路径解析见 artifacts.defaultPath 与册级 bindings.json——这是「工序公有、经验私有」在文件层的落点。"
 },
 "artifacts": {
  "_doc": {
   "defaultPath": "工作区相对路径。可被册级 bindings.json 覆盖。没有 defaultPath 的必须由册级绑定。",
   "external": "true = 本链的任何步骤都不产出它。它要么是外部既有资产,要么由智能体在链外裁决产出。",
   "authoredBy": "external 的来源。shared-asset=既有共享资产(需绑绝对路径);agent=智能体介入产出(有默认约定路径)。",
   "glob": "true = 该 id 展开为多文件;hash 按文件名排序后串联计算。",
   "_agentBoundaryIsMeasurable": "authoredBy=agent 的恰好三个,对应 SKILL 里说的「智能体只在两处介入」:建表(schema)与图/公式逐张裁决(mapping.substitutions,并入 mapping)。这条边界因此不是散文,是可以数的字段——多出第四个,就是有活悄悄从工序漏回了人身上。"
  },
  "source": {
   "external": true,
   "authoredBy": "shared-asset",
   "what": "源原始稿(冻结证据)"
  },
  "params": {
   "external": true,
   "authoredBy": "shared-asset",
   "what": "共享参数表"
  },
  "spec": {
   "external": true,
   "authoredBy": "shared-asset",
   "what": "共享私有规范"
  },
  "assets.cover": {
   "external": true,
   "authoredBy": "shared-asset",
   "glob": true,
   "what": "封皮封底素材(既有资产,非本链产出)"
  },
  "mapping.shared": {
   "external": true,
   "authoredBy": "shared-asset",
   "what": "跨册共享的私有规范映射真源(target/principles/typography 等整节取用)"
  },
  "seeds.templates": {
   "external": true,
   "authoredBy": "shared-asset",
   "glob": true,
   "defaultPath": "seeds/templates/*.json",
   "what": "包内已知模板表,供指纹比对。路径相对包根,由 bindings 绑绝对路径。"
